    {
      "parameters": {
        "jsCode": "// Check if enough time has passed since last run using workflow static data\nconst project = $json.project;\n\n// Get last run time from workflow static data\nconst staticData = $workflow.staticData || {};\nconst lastRuns = staticData.lastRuns || {};\nconst lastRun = lastRuns[project];\n\nconst now = new Date();\nconst thresholds = {\n  judicial: 7 * 24 * 60 * 60 * 1000,   // 7 days\n  executive: 7 * 24 * 60 * 60 * 1000,  // 7 days\n  civic: 24 * 60 * 60 * 1000           // 1 day\n};\n\nlet shouldRun = true;\nlet hoursSinceLastRun = null;\n\nif (lastRun) {\n  const lastRunTime = new Date(lastRun);\n  const timeSinceLastRun = now - lastRunTime;\n  hoursSinceLastRun = Math.floor(timeSinceLastRun / (1000 * 60 * 60));\n  shouldRun = timeSinceLastRun > thresholds[project];\n}\n\nreturn [{\n  json: {\n    project: project,\n    should_run: shouldRun,\n    last_run: lastRun || null,\n    hours_since_last_run: hoursSinceLastRun\n  }\n}];"
      },
      "id": "check-last-run",
      "name": "Check Last Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 500]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.should_run }}",
              "value2": true
            }
          ]
        }

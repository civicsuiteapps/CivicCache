      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\n\ntry {\n  const output = execSync(\n    'python3 /Users/abrooks/GIT/JudicialCache/judicial_pipeline.py',\n    { encoding: 'utf8', maxBuffer: 10 * 1024 * 1024 }\n  );\n  \n  return [{\n    json: {\n      project: 'judicial',\n      success: true,\n      output: output,\n      timestamp: new Date().toISOString()\n    }\n  }];\n} catch (error) {\n  throw new Error(`JudicialCache pipeline failed: ${error.message}\\n${error.stdout}\\n${error.stderr}`);\n}"
      },

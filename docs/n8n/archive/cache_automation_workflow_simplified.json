    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst project = $json.project;\nconst projectCapitalized = project.charAt(0).toUpperCase() + project.slice(1);\nconst stateFile = `/Users/abrooks/GIT/${projectCapitalized}Cache/data/pipeline_state.json`;\n\nlet state = { last_successful_run: null };\nif (fs.existsSync(stateFile)) {\n  const stateData = fs.readFileSync(stateFile, 'utf8');\n  state = JSON.parse(stateData);\n}\n\nconst now = new Date();\nconst thresholds = {\n  judicial: 7 * 24 * 60 * 60 * 1000,\n  executive: 7 * 24 * 60 * 60 * 1000,\n  civic: 24 * 60 * 60 * 1000\n};\n\nconst shouldRun = !state.last_successful_run ||\n  (now - new Date(state.last_successful_run)) > thresholds[project];\n\nreturn [{\n  json: {\n    project: project,\n    should_run: shouldRun,\n    last_run: state.last_successful_run,\n    hours_since_last_run: state.last_successful_run\n      ? Math.floor((now - new Date(state.last_successful_run)) / (1000 * 60 * 60))\n      : null\n  }\n}];"
      },
